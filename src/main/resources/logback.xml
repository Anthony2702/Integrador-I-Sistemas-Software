<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuración de Logback: muestra los eventos en consola y los guarda en logs/ (un archivo por día). -->
<configuration>
    <property name="LOG_DIR" value="logs"/>

    <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="ARCHIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/autodev-licencias.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/autodev-licencias.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.autodev" level="DEBUG"/>
    <logger name="org.apache.poi" level="WARN"/>
    <logger name="com.mysql" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLA"/>
        <appender-ref ref="ARCHIVO"/>
    </root>
</configuration>
