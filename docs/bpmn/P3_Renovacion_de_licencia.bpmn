<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_P3" targetNamespace="http://autodev.pe/bpmn">
  <collaboration id="Colaboracion_P3">
    <participant id="Pool_P3" name="P3 Renovación de licencia" processRef="Proceso_P3" />
  </collaboration>
  <process id="Proceso_P3" name="P3 Renovación de licencia" isExecutable="false">
    <laneSet id="Carriles_P3">
      <lane id="Carril_P3_0" name="Cliente">
        <flowNodeRef>P3_s1</flowNodeRef>
        <flowNodeRef>P3_t1</flowNodeRef>
      </lane>
      <lane id="Carril_P3_1" name="Vendedor AUTODEV">
        <flowNodeRef>P3_t2</flowNodeRef>
      </lane>
      <lane id="Carril_P3_2" name="Sistema AUTODEV">
        <flowNodeRef>P3_t3</flowNodeRef>
        <flowNodeRef>P3_g1</flowNodeRef>
        <flowNodeRef>P3_t4</flowNodeRef>
        <flowNodeRef>P3_t5</flowNodeRef>
        <flowNodeRef>P3_t6</flowNodeRef>
        <flowNodeRef>P3_t7</flowNodeRef>
        <flowNodeRef>P3_e1</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="P3_s1" name="Acepta renovar su licencia">
      <outgoing>P3_f1</outgoing>
    </startEvent>
    <task id="P3_t1" name="Paga la renovación">
      <incoming>P3_f1</incoming>
      <outgoing>P3_f2</outgoing>
    </task>
    <task id="P3_t2" name="Elige la licencia y pulsa Renovar">
      <incoming>P3_f2</incoming>
      <outgoing>P3_f3</outgoing>
    </task>
    <task id="P3_t3" name="Busca la licencia anterior del mismo programa">
      <incoming>P3_f3</incoming>
      <outgoing>P3_f4</outgoing>
    </task>
    <exclusiveGateway id="P3_g1" name="¿La anterior aún no vence?">
      <incoming>P3_f4</incoming>
      <outgoing>P3_f5</outgoing>
      <outgoing>P3_f6</outgoing>
    </exclusiveGateway>
    <task id="P3_t4" name="Nueva emisión = vencimiento anterior">
      <incoming>P3_f5</incoming>
      <outgoing>P3_f7</outgoing>
    </task>
    <task id="P3_t5" name="Nueva emisión = fecha de pago">
      <incoming>P3_f6</incoming>
      <outgoing>P3_f8</outgoing>
    </task>
    <task id="P3_t6" name="Calcula vencimiento (+1 año) y guarda">
      <incoming>P3_f7</incoming>
      <incoming>P3_f8</incoming>
      <outgoing>P3_f9</outgoing>
    </task>
    <task id="P3_t7" name="Marca la anterior como Renovada y cierra sus alertas">
      <incoming>P3_f9</incoming>
      <outgoing>P3_f10</outgoing>
    </task>
    <endEvent id="P3_e1" name="Licencia renovada">
      <incoming>P3_f10</incoming>
    </endEvent>
    <sequenceFlow id="P3_f1" sourceRef="P3_s1" targetRef="P3_t1" />
    <sequenceFlow id="P3_f2" sourceRef="P3_t1" targetRef="P3_t2" />
    <sequenceFlow id="P3_f3" sourceRef="P3_t2" targetRef="P3_t3" />
    <sequenceFlow id="P3_f4" sourceRef="P3_t3" targetRef="P3_g1" />
    <sequenceFlow id="P3_f5" name="Sí" sourceRef="P3_g1" targetRef="P3_t4" />
    <sequenceFlow id="P3_f6" name="No" sourceRef="P3_g1" targetRef="P3_t5" />
    <sequenceFlow id="P3_f7" sourceRef="P3_t4" targetRef="P3_t6" />
    <sequenceFlow id="P3_f8" sourceRef="P3_t5" targetRef="P3_t6" />
    <sequenceFlow id="P3_f9" sourceRef="P3_t6" targetRef="P3_t7" />
    <sequenceFlow id="P3_f10" sourceRef="P3_t7" targetRef="P3_e1" />
  </process>
  <bpmndi:BPMNDiagram id="Diagrama_P3">
    <bpmndi:BPMNPlane id="Plano_P3" bpmnElement="Colaboracion_P3">
      <bpmndi:BPMNShape id="Pool_P3_di" bpmnElement="Pool_P3" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1565" height="530" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_P3_0_di" bpmnElement="Carril_P3_0" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="1535" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_P3_1_di" bpmnElement="Carril_P3_1" isHorizontal="true">
        <dc:Bounds x="50" y="170" width="1535" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_P3_2_di" bpmnElement="Carril_P3_2" isHorizontal="true">
        <dc:Bounds x="50" y="320" width="1535" height="230" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P3_s1_di" bpmnElement="P3_s1">
        <dc:Bounds x="137" y="77" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="100" y="117" width="110" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P3_t1_di" bpmnElement="P3_t1">
        <dc:Bounds x="260" y="60" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P3_t2_di" bpmnElement="P3_t2">
        <dc:Bounds x="425" y="210" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P3_t3_di" bpmnElement="P3_t3">
        <dc:Bounds x="590" y="360" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P3_g1_di" bpmnElement="P3_g1" isMarkerVisible="true">
        <dc:Bounds x="790" y="370" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="760" y="326" width="110" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P3_t4_di" bpmnElement="P3_t4">
        <dc:Bounds x="920" y="360" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P3_t5_di" bpmnElement="P3_t5">
        <dc:Bounds x="920" y="460" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P3_t6_di" bpmnElement="P3_t6">
        <dc:Bounds x="1085" y="360" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P3_t7_di" bpmnElement="P3_t7">
        <dc:Bounds x="1250" y="360" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P3_e1_di" bpmnElement="P3_e1">
        <dc:Bounds x="1457" y="377" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1420" y="417" width="110" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P3_f1_di" bpmnElement="P3_f1">
        <di:waypoint x="173" y="95" />
        <di:waypoint x="260" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P3_f2_di" bpmnElement="P3_f2">
        <di:waypoint x="380" y="95" />
        <di:waypoint x="485" y="95" />
        <di:waypoint x="485" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P3_f3_di" bpmnElement="P3_f3">
        <di:waypoint x="545" y="245" />
        <di:waypoint x="650" y="245" />
        <di:waypoint x="650" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P3_f4_di" bpmnElement="P3_f4">
        <di:waypoint x="710" y="395" />
        <di:waypoint x="790" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P3_f5_di" bpmnElement="P3_f5">
        <di:waypoint x="840" y="395" />
        <di:waypoint x="920" y="395" />
        <bpmndi:BPMNLabel><dc:Bounds x="868" y="373" width="50" height="16" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P3_f6_di" bpmnElement="P3_f6">
        <di:waypoint x="815" y="420" />
        <di:waypoint x="815" y="495" />
        <di:waypoint x="920" y="495" />
        <bpmndi:BPMNLabel><dc:Bounds x="821" y="448" width="50" height="16" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P3_f7_di" bpmnElement="P3_f7">
        <di:waypoint x="1040" y="395" />
        <di:waypoint x="1085" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P3_f8_di" bpmnElement="P3_f8">
        <di:waypoint x="1040" y="495" />
        <di:waypoint x="1145" y="495" />
        <di:waypoint x="1145" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P3_f9_di" bpmnElement="P3_f9">
        <di:waypoint x="1205" y="395" />
        <di:waypoint x="1250" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P3_f10_di" bpmnElement="P3_f10">
        <di:waypoint x="1370" y="395" />
        <di:waypoint x="1457" y="395" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
