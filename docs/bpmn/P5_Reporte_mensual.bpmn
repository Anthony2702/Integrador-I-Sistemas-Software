<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_P5" targetNamespace="http://autodev.pe/bpmn">
  <collaboration id="Colaboracion_P5">
    <participant id="Pool_P5" name="P5 Reporte mensual de ventas y cartera" processRef="Proceso_P5" />
  </collaboration>
  <process id="Proceso_P5" name="P5 Reporte mensual de ventas y cartera" isExecutable="false">
    <laneSet id="Carriles_P5">
      <lane id="Carril_P5_0" name="Administrador">
        <flowNodeRef>P5_s1</flowNodeRef>
        <flowNodeRef>P5_t1</flowNodeRef>
        <flowNodeRef>P5_t5</flowNodeRef>
        <flowNodeRef>P5_g1</flowNodeRef>
        <flowNodeRef>P5_t6</flowNodeRef>
        <flowNodeRef>P5_e1</flowNodeRef>
      </lane>
      <lane id="Carril_P5_1" name="Sistema AUTODEV">
        <flowNodeRef>P5_t2</flowNodeRef>
        <flowNodeRef>P5_t3</flowNodeRef>
        <flowNodeRef>P5_t4</flowNodeRef>
        <flowNodeRef>P5_t7</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="P5_s1" name="Revisión de fin de mes">
      <outgoing>P5_f1</outgoing>
    </startEvent>
    <task id="P5_t1" name="Abre el Resumen y elige el mes">
      <incoming>P5_f1</incoming>
      <outgoing>P5_f2</outgoing>
    </task>
    <task id="P5_t2" name="Actualiza el estado de las licencias">
      <incoming>P5_f2</incoming>
      <outgoing>P5_f3</outgoing>
    </task>
    <task id="P5_t3" name="Calcula ingresos, meta y ventas por programa">
      <incoming>P5_f3</incoming>
      <outgoing>P5_f4</outgoing>
    </task>
    <task id="P5_t4" name="Cuenta vigentes, por vencer, vencidas y clientes activos">
      <incoming>P5_f4</incoming>
      <outgoing>P5_f5</outgoing>
    </task>
    <task id="P5_t5" name="Analiza el avance de la meta">
      <incoming>P5_f5</incoming>
      <outgoing>P5_f6</outgoing>
    </task>
    <exclusiveGateway id="P5_g1" name="¿Necesita el detalle?">
      <incoming>P5_f6</incoming>
      <outgoing>P5_f7</outgoing>
      <outgoing>P5_f8</outgoing>
    </exclusiveGateway>
    <task id="P5_t6" name="Exporta las licencias a Excel">
      <incoming>P5_f7</incoming>
      <outgoing>P5_f9</outgoing>
    </task>
    <task id="P5_t7" name="Genera el archivo .xlsx (Apache POI)">
      <incoming>P5_f9</incoming>
      <outgoing>P5_f10</outgoing>
    </task>
    <endEvent id="P5_e1" name="Reporte revisado">
      <incoming>P5_f8</incoming>
      <incoming>P5_f10</incoming>
    </endEvent>
    <sequenceFlow id="P5_f1" sourceRef="P5_s1" targetRef="P5_t1" />
    <sequenceFlow id="P5_f2" sourceRef="P5_t1" targetRef="P5_t2" />
    <sequenceFlow id="P5_f3" sourceRef="P5_t2" targetRef="P5_t3" />
    <sequenceFlow id="P5_f4" sourceRef="P5_t3" targetRef="P5_t4" />
    <sequenceFlow id="P5_f5" sourceRef="P5_t4" targetRef="P5_t5" />
    <sequenceFlow id="P5_f6" sourceRef="P5_t5" targetRef="P5_g1" />
    <sequenceFlow id="P5_f7" name="Sí" sourceRef="P5_g1" targetRef="P5_t6" />
    <sequenceFlow id="P5_f8" name="No" sourceRef="P5_g1" targetRef="P5_e1" />
    <sequenceFlow id="P5_f9" sourceRef="P5_t6" targetRef="P5_t7" />
    <sequenceFlow id="P5_f10" sourceRef="P5_t7" targetRef="P5_e1" />
  </process>
  <bpmndi:BPMNDiagram id="Diagrama_P5">
    <bpmndi:BPMNPlane id="Plano_P5" bpmnElement="Colaboracion_P5">
      <bpmndi:BPMNShape id="Pool_P5_di" bpmnElement="Pool_P5" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1730" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_P5_0_di" bpmnElement="Carril_P5_0" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="1700" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_P5_1_di" bpmnElement="Carril_P5_1" isHorizontal="true">
        <dc:Bounds x="50" y="170" width="1700" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_s1_di" bpmnElement="P5_s1">
        <dc:Bounds x="137" y="77" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="100" y="117" width="110" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_t1_di" bpmnElement="P5_t1">
        <dc:Bounds x="260" y="60" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_t2_di" bpmnElement="P5_t2">
        <dc:Bounds x="425" y="210" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_t3_di" bpmnElement="P5_t3">
        <dc:Bounds x="590" y="210" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_t4_di" bpmnElement="P5_t4">
        <dc:Bounds x="755" y="210" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_t5_di" bpmnElement="P5_t5">
        <dc:Bounds x="920" y="60" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_g1_di" bpmnElement="P5_g1" isMarkerVisible="true">
        <dc:Bounds x="1120" y="70" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1090" y="124" width="110" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_t6_di" bpmnElement="P5_t6">
        <dc:Bounds x="1250" y="60" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_t7_di" bpmnElement="P5_t7">
        <dc:Bounds x="1415" y="210" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P5_e1_di" bpmnElement="P5_e1">
        <dc:Bounds x="1622" y="77" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1585" y="117" width="110" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P5_f1_di" bpmnElement="P5_f1">
        <di:waypoint x="173" y="95" />
        <di:waypoint x="260" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f2_di" bpmnElement="P5_f2">
        <di:waypoint x="380" y="95" />
        <di:waypoint x="485" y="95" />
        <di:waypoint x="485" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f3_di" bpmnElement="P5_f3">
        <di:waypoint x="545" y="245" />
        <di:waypoint x="590" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f4_di" bpmnElement="P5_f4">
        <di:waypoint x="710" y="245" />
        <di:waypoint x="755" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f5_di" bpmnElement="P5_f5">
        <di:waypoint x="875" y="245" />
        <di:waypoint x="980" y="245" />
        <di:waypoint x="980" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f6_di" bpmnElement="P5_f6">
        <di:waypoint x="1040" y="95" />
        <di:waypoint x="1120" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f7_di" bpmnElement="P5_f7">
        <di:waypoint x="1170" y="95" />
        <di:waypoint x="1250" y="95" />
        <bpmndi:BPMNLabel><dc:Bounds x="1198" y="73" width="50" height="16" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f8_di" bpmnElement="P5_f8">
        <di:waypoint x="1145" y="70" />
        <di:waypoint x="1145" y="34" />
        <di:waypoint x="1640" y="34" />
        <di:waypoint x="1640" y="77" />
        <bpmndi:BPMNLabel><dc:Bounds x="1151" y="42" width="50" height="16" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f9_di" bpmnElement="P5_f9">
        <di:waypoint x="1370" y="95" />
        <di:waypoint x="1475" y="95" />
        <di:waypoint x="1475" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P5_f10_di" bpmnElement="P5_f10">
        <di:waypoint x="1535" y="245" />
        <di:waypoint x="1640" y="245" />
        <di:waypoint x="1640" y="113" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
